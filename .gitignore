# Godot 4 .gitignore
# Generated files
.godot/

# Builds
build/
builds/
export/

# IDE
.idea/
.vscode/
*.code-workspace

# macOS
.DS_Store
*.DS_Store

# GUT addons (installed by CI / dev setup script)
addons/gut/

# Export templates (large binaries, downloaded by CI)
# ~/.local/share/godot/export_templates/

# Temporary files
*.tmp
*.log
